{
  "entities": {
    "PlayerProfile": {
      "title": "PlayerProfile",
      "description": "Private commander profile stored under players/{userId}. Strictly owner-only.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID matching document ID" },
        "displayName": { "type": "string", "description": "Commander display name (max 80 chars)" },
        "xpTotal": { "type": "integer", "description": "Cumulative commander XP (>= 0)" },
        "campaignsCompleted": { "type": "integer", "description": "Number of completed campaigns (>= 0)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": ["uid", "displayName", "xpTotal", "campaignsCompleted", "createdAt", "updatedAt"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Owner-scoped saved EXO WORLD 2050 campaign with full WorldState snapshot.",
      "type": "object",
      "properties": {
        "campaignId": { "type": "string", "description": "Campaign identifier matching document ID" },
        "ownerId": { "type": "string", "description": "Firebase Auth UID of the campaign owner" },
        "worldSeed": { "type": "string", "description": "Deterministic PCG32 world seed" },
        "superpowerId": { "type": "string", "description": "Selected superpower ID" },
        "era": { "type": "integer", "description": "Campaign era (1 to 6)" },
        "cycle": { "type": "integer", "description": "Current turn cycle (>= 0)" },
        "tick": { "type": "integer", "description": "Simulation tick (>= 0)" },
        "atmosphereTier": { "type": "string", "enum": ["P1", "P2", "P3", "P4"], "description": "Terraforming atmosphere tier" },
        "stateHash": { "type": "string", "description": "Deterministic SHA-256 state hash" },
        "snapshot": { "type": "object", "description": "Full native WorldState map" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": [
        "campaignId",
        "ownerId",
        "worldSeed",
        "superpowerId",
        "era",
        "cycle",
        "tick",
        "atmosphereTier",
        "stateHash",
        "snapshot",
        "createdAt",
        "updatedAt"
      ]
    },
    "TurnSnapshotRecord": {
      "title": "TurnSnapshotRecord",
      "description": "Immutable turn_snapshots archive entry with 4-phase combat resolution breakdown.",
      "type": "object",
      "properties": {
        "snapshotId": { "type": "string", "description": "Snapshot ID matching document ID" },
        "campaignId": { "type": "string", "description": "Parent campaign ID" },
        "ownerId": { "type": "string", "description": "Firebase Auth UID of owner" },
        "cycle": { "type": "integer", "description": "Turn cycle number (>= 0)" },
        "stateHash": { "type": "string", "description": "Deterministic hash of the turn snapshot" },
        "combatCount": { "type": "integer", "description": "Number of 4-phase combat engagements recorded" },
        "snapshot": { "type": "object", "description": "Native TurnSnapshot payload map" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" }
      },
      "required": ["snapshotId", "campaignId", "ownerId", "cycle", "stateHash", "combatCount", "snapshot", "createdAt"]
    },
    "DriveLinkRecord": {
      "title": "DriveLinkRecord",
      "description": "Reference to a Google Drive file selected via Google Picker and linked to a campaign.",
      "type": "object",
      "properties": {
        "linkId": { "type": "string", "description": "Link ID matching document ID" },
        "campaignId": { "type": "string", "description": "Parent campaign ID" },
        "ownerId": { "type": "string", "description": "Firebase Auth UID of owner" },
        "fileId": { "type": "string", "description": "Google Drive file ID" },
        "fileName": { "type": "string", "description": "Google Drive file display name" },
        "mimeType": { "type": "string", "description": "MIME type returned by Google Picker" },
        "webViewLink": { "type": "string", "description": "HTTPS link to file in Google Drive" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" }
      },
      "required": ["linkId", "campaignId", "ownerId", "fileId", "fileName", "mimeType", "webViewLink", "createdAt"]
    },
    "UserContextRecord": {
      "title": "UserContextRecord",
      "description": "Strictly owner-scoped 3-Dimension User Context isolating shellUxHabits, displaySettingsProfile, and simulationTraceabilityProfile.",
      "type": "object",
      "properties": {
        "contextId": { "type": "string", "description": "Context slot ID matching document ID" },
        "ownerId": { "type": "string", "description": "Firebase Auth UID of the owner" },
        "shellUxHabits": { "type": "object", "description": "Remembered accordions and navigation preferences" },
        "displaySettingsProfile": { "type": "object", "description": "Theme, Safari sync, saturation and opacity profile" },
        "simulationTraceabilityProfile": { "type": "object", "description": "TraceabilityMatrix and campaign EventLog records" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": ["contextId", "ownerId", "shellUxHabits", "displaySettingsProfile", "simulationTraceabilityProfile", "updatedAt"]
    },
    "MetaHonorsRecord": {
      "title": "MetaHonorsRecord",
      "description": "Cross-campaign player lobby showcase (Medals, Badges, Career Title, Avatar/Portrait, Banner).",
      "type": "object",
      "properties": {
        "honorsId": { "type": "string", "description": "Showcase profile document ID" },
        "ownerId": { "type": "string", "description": "Firebase Auth UID of the owner" },
        "payload": { "type": "object", "description": "Serialized Tier-1 lobby honors showcase" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": ["honorsId", "ownerId", "payload", "updatedAt"]
    },
    "DocVcsEntryRecord": {
      "title": "DocVcsEntryRecord",
      "description": "Version-controlled documentation entry mirrored for verified owners.",
      "type": "object",
      "properties": {
        "docId": { "type": "string", "description": "Document ID matching document key" },
        "ownerId": { "type": "string", "description": "Firebase Auth UID of owner" },
        "title": { "type": "string", "description": "Document display title" },
        "category": { "type": "string", "description": "Documentation category" },
        "domain": { "type": "string", "description": "Domain scope" },
        "linkedSkillId": { "type": "string", "description": "Optional linked modular skill ID" },
        "driveFileId": { "type": "string", "description": "Optional linked Google Drive file ID" },
        "driveUrl": { "type": "string", "description": "Optional HTTPS Google Drive/Docs link" },
        "currentSemver": { "type": "string", "description": "Current SemVer" },
        "currentRevisionId": { "type": "string", "description": "Active revision ID" },
        "currentContentHash": { "type": "string", "description": "Content digest" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": [
        "docId",
        "ownerId",
        "title",
        "category",
        "domain",
        "linkedSkillId",
        "driveFileId",
        "driveUrl",
        "currentSemver",
        "currentRevisionId",
        "currentContentHash",
        "updatedAt"
      ]
    },
    "DocVcsRevisionRecord": {
      "title": "DocVcsRevisionRecord",
      "description": "Immutable documentation revision record for diff & non-destructive revert.",
      "type": "object",
      "properties": {
        "revisionId": { "type": "string", "description": "Revision ID" },
        "docId": { "type": "string", "description": "Parent document ID" },
        "ownerId": { "type": "string", "description": "Firebase Auth UID of owner" },
        "semver": { "type": "string", "description": "Revision SemVer" },
        "contentHash": { "type": "string", "description": "Content digest" },
        "author": { "type": "string", "description": "Author name" },
        "summary": { "type": "string", "description": "Change summary" },
        "parentRevisionId": { "type": "string", "description": "Parent revision ID or empty" },
        "source": { "type": "string", "enum": ["LOCAL", "REVERT", "DRIVE_IMPORT"], "description": "Origin" },
        "content": { "type": "string", "description": "Markdown text snapshot" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" }
      },
      "required": [
        "revisionId",
        "docId",
        "ownerId",
        "semver",
        "contentHash",
        "author",
        "summary",
        "parentRevisionId",
        "source",
        "content",
        "createdAt"
      ]
    },
    "ModularSkillRecord": {
      "title": "ModularSkillRecord",
      "description": "Self-contained modular skill registry state separated from documentation prose.",
      "type": "object",
      "properties": {
        "skillId": { "type": "string", "description": "Skill ID" },
        "ownerId": { "type": "string", "description": "Firebase Auth UID of owner" },
        "code": { "type": "string", "description": "Skill short code" },
        "name": { "type": "string", "description": "Skill display name" },
        "domain": { "type": "string", "description": "Skill domain" },
        "hookKind": { "type": "string", "description": "Runtime hook classification" },
        "semver": { "type": "string", "description": "Independent skill SemVer" },
        "enabled": { "type": "boolean", "description": "Active toggle" },
        "entryModule": { "type": "string", "description": "Source module path" },
        "docId": { "type": "string", "description": "Separated external docId pointer" },
        "config": { "type": "object", "description": "Modular runtime configuration" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": [
        "skillId",
        "ownerId",
        "code",
        "name",
        "domain",
        "hookKind",
        "semver",
        "enabled",
        "entryModule",
        "docId",
        "config",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/players/{userId}": {
      "schema": { "$ref": "#/entities/PlayerProfile" },
      "description": "Private player profiles restricted strictly to the authenticated verified owner."
    },
    "/players/{userId}/context/{contextId}": {
      "schema": { "$ref": "#/entities/UserContextRecord" },
      "description": "Owner-only 3D User Context persistence (UX habits, display settings, traceability)."
    },
    "/players/{userId}/metaHonors/{honorsId}": {
      "schema": { "$ref": "#/entities/MetaHonorsRecord" },
      "description": "Owner-only cross-campaign lobby honors showcase (medals, badges, titles, avatar)."
    },
    "/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/Campaign" },
      "description": "Saved EXO WORLD 2050 campaigns scoped to ownerId == request.auth.uid."
    },
    "/campaigns/{campaignId}/turnSnapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/TurnSnapshotRecord" },
      "description": "Append-only turn_snapshots and 4-phase combat history records under an owner-verified campaign."
    },
    "/campaigns/{campaignId}/driveLinks/{linkId}": {
      "schema": { "$ref": "#/entities/DriveLinkRecord" },
      "description": "Google Picker linked Drive files associated with an owner-verified campaign."
    },
    "/docEntries/{docId}": {
      "schema": { "$ref": "#/entities/DocVcsEntryRecord" },
      "description": "Owner-scoped version-controlled documentation metadata."
    },
    "/docEntries/{docId}/revisions/{revId}": {
      "schema": { "$ref": "#/entities/DocVcsRevisionRecord" },
      "description": "Append-only documentation revision snapshots for diff and revert."
    },
    "/skillRegistry/{skillId}": {
      "schema": { "$ref": "#/entities/ModularSkillRecord" },
      "description": "Owner-scoped modular skills registry decoupled from documentation."
    }
  }
}
