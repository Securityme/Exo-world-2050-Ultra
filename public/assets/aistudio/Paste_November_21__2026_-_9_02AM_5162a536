2. src/services/architecture/matrix-engine.ts
Moteur pur et isomorphe des 16 matrices (M0–M15) : validation ICOM (verticale/horizontale), détection de cycles DSM (0 ↺), contrôle SemVer-2.0.0, détection de DRIFT ! et calcul du Release Gate GO / NO-GO.
export type MatrixId =
  | 'M0' | 'M1' | 'M2' | 'M3' | 'M4' | 'M5' | 'M6' | 'M7'
  | 'M8' | 'M9' | 'M10' | 'M11' | 'M12' | 'M13' | 'M14' | 'M15';

export type MatrixRef = MatrixId | 'M13-A' | 'M13-D' | 'M15-A' | 'M15-B';
export type Sadtdim = 'D0' | 'D1' | 'D2' | 'D3' | 'D4' | 'D5';
export type SemVerPropagation = 'ISOLÉ' | 'BULLE ↑' | 'CASCADE ⚠';
export type NodeStatus = 'DRAFT' | 'REVIEW' | 'LOCKED' | 'ACTIVE' | 'DEPRECATED';
export type TriLock = readonly [0 | 1, 0 | 1, 0 | 1];

export interface IcomFlow {
  inputs: string[];
  controls: string[];
  outputs: string[];
  mechanisms: string[];
  tunnels: string[];
}

export interface FractalNodeMeta {
  id: string;
  dim: Sadtdim;
  depth: number;
  parent_id: string | null;
  root_ref: string;
  semver: string;
  root_compat: string;
  tri_lock: TriLock;
  propagation: SemVerPropagation;
  lts_frozen: boolean;
  neon_branch: string;
  updated_at: string;
  status: NodeStatus;
  trl: number;
  standards: string[];
  matrices_used: MatrixRef[];
  box_refs: string[];
  coupling_links: string[];
}

export interface M0Manifest {
  root_ref: string;
  directive_ref: string;
  iso_whitelist: string[];
  nodes: FractalNodeMeta[];
}

export interface Sadtd2Box {
  id: string;
  label: string;
  icom: IcomFlow;
  src_layers: string[];
  owner: string;
  data_box: string;
}

export interface Sadtd1Box {
  id: string;
  label: string;
  icom: IcomFlow;
  data_box: string;
  dsm_depends_on: string[];
  sub_boxes: Sadtd2Box[];
}

export interface DatagramBox {
  id: string;
  label: string;
  creator: string;
  validator: string;
  consumers: string[];
  storage: string;
  source_of_truth: string;
}

export interface M13Manifest {
  semver: string;
  d1_boxes: Sadtd1Box[];
  datagrams: DatagramBox[];
  src_manifest: Record<string, string[]>;
}

export interface MatrixEngineReport {
  gate: 'GO' | 'NO-GO';
  matricesCovered: number;
  missingMatrices: MatrixId[];
  driftNodes: string[];
  dsmCycles: string[][];
  icomViolations: string[];
  isoViolations: string[];
  d2BoxCount: number;
  errors: string[];
}

const ALL_MATRICES: readonly MatrixId[] = [
  'M0', 'M1', 'M2', 'M3', 'M4', 'M5', 'M6', 'M7',
  'M8', 'M9', 'M10', 'M11', 'M12', 'M13', 'M14', 'M15',
];

const SEMVER_RE = /^\d+\.\d+\.\d+(?:-(?:alpha|beta|rc|lts)\.\d+)?(?:\+[a-z0-9.-]+)?$/i;

function normalizeMatrixId(ref: MatrixRef): MatrixId {
  if (ref === 'M13-A' || ref === 'M13-D') return 'M13';
  if (ref === 'M15-A' || ref === 'M15-B') return 'M15';
  return ref;
}

function majorOf(version: string): number {
  return Number.parseInt(version.replace(/^[\^~v=]/, '').split('.')[0] ?? '0', 10);
}

export function evaluateSemVerAndDrift(m0: M0Manifest): {
  driftNodes: string[];
  isoViolations: string[];
  errors: string[];
} {
  const driftNodes: string[] = [];
  const isoViolations: string[] = [];
  const errors: string[] = [];
  const rootMajor = majorOf(m0.root_ref.split('@')[1] ?? '0.0.0');
  const allowedIso = new Set(m0.iso_whitelist);
  const ids = new Set(m0.nodes.map((n) => n.id));

  for (const node of m0.nodes) {
    if (!SEMVER_RE.test(node.semver)) errors.push(`EXOW-E019: SemVer invalide sur ${node.id} (${node.semver})`);
    if (node.parent_id && !ids.has(node.parent_id)) errors.push(`EXOW-E019: Parent absent ${node.parent_id} pour ${node.id}`);
    if (majorOf(node.root_compat) !== rootMajor) driftNodes.push(`${node.id} (compat ${node.root_compat} ≠ v${rootMajor})`);
    if (node.lts_frozen && node.propagation !== 'ISOLÉ') driftNodes.push(`${node.id} (lts_frozen violé: ${node.propagation})`);
    for (const std of node.standards) {
      if (!allowedIso.has(std)) isoViolations.push(`${node.id}: norme hors registre (${std})`);
    }
  }
  return { driftNodes, isoViolations, errors };
}

export function checkDsmCycles(boxes: Sadtd1Box[]): string[][] {
  const graph = new Map(boxes.map((b) => [b.id, b.dsm_depends_on]));
  const visited = new Set<string>();
  const stack = new Set<string>();
  const cycles: string[][] = [];

  const dfs = (id: string, path: string[]): void => {
    visited.add(id);
    stack.add(id);
    for (const dep of graph.get(id) ?? []) {
      if (stack.has(dep)) cycles.push([...path.slice(path.indexOf(dep)), dep]);
      else if (!visited.has(dep)) dfs(dep, [...path, dep]);
    }
    stack.delete(id);
  };

  for (const box of boxes) {
    if (!visited.has(box.id)) dfs(box.id, [box.id]);
  }
  return cycles;
}

export function checkIcomConservation(m13: M13Manifest): { violations: string[]; d2Count: number } {
  const violations: string[] = [];
  const datagramIds = new Set(m13.datagrams.map((d) => d.id));
  let d2Count = 0;

  for (const d1 of m13.d1_boxes) {
    if (!datagramIds.has(d1.data_box)) violations.push(`${d1.id}: datagramme ${d1.data_box} manquant (M13-D)`);
    if (d1.sub_boxes.length < 3 || d1.sub_boxes.length > 6) {
      violations.push(`${d1.id}: quota SADT 3..6 violé (${d1.sub_boxes.length} sous-boîtes)`);
    }
    for (const d2 of d1.sub_boxes) {
      d2Count += 1;
      if (d2.icom.inputs.length === 0 || d2.icom.outputs.length === 0) {
        violations.push(`${d2.id}: ICOM incomplet (I ou O vide)`);
      }
      if (!datagramIds.has(d2.data_box)) violations.push(`${d2.id}: cible M13-D inconnue (${d2.data_box})`);
    }
  }
  return { violations, d2Count };
}

export function runMatrixEngineAudit(m0: M0Manifest, m13: M13Manifest): MatrixEngineReport {
  const covered = new Set<MatrixId>();
  for (const node of m0.nodes) {
    for (const ref of node.matrices_used) covered.add(normalizeMatrixId(ref));
  }
  const missingMatrices = ALL_MATRICES.filter((id) => !covered.has(id));
  const semverRes = evaluateSemVerAndDrift(m0);
  const dsmCycles = checkDsmCycles(m13.d1_boxes);
  const icomRes = checkIcomConservation(m13);

  const errors = [
    ...semverRes.errors,
    ...semverRes.isoViolations,
    ...icomRes.violations,
    ...missingMatrices.map((m) => `Matrice manquante dans M0: ${m}`),
    ...dsmCycles.map((c) => `Cycle DSM détecté (↺): ${c.join(' → ')}`),
  ];
  const gate = errors.length === 0 && semverRes.driftNodes.length === 0 ? 'GO' : 'NO-GO';

  return {
    gate,
    matricesCovered: covered.size,
    missingMatrices,
    driftNodes: semverRes.driftNodes,
    dsmCycles,
    icomViolations: icomRes.violations,
    isoViolations: semverRes.isoViolations,
    d2BoxCount: icomRes.d2Count,
    errors,
  };
}

