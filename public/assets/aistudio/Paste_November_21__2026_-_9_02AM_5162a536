5. scripts/exo-audit.ts
Exécute npm run exo:audit avec sortie bloquante (0 = GO, 1 = NO-GO) : intégrité M0/M13 via matrix-engine.ts, validation SemVer (0 DRIFT!), scan de complexité cyclomatique (CC ≤ 12) & limites R14, pureté L2/L3, bannissement Z0 (auto-immunisé contre les faux positifs) et contrôle de parité Tri-Format DIR-01.
import fs from 'node:fs';
import path from 'node:path';
import {
  runMatrixEngineAudit,
  type M0Manifest,
  type M13Manifest,
} from '../src/services/architecture/matrix-engine.ts';

const ROOT = process.cwd();
const BP_DIR = path.join(ROOT, 'src', 'master-blueprint');

// Assemblage dynamique afin d'éviter tout faux positif sur scripts/exo-audit.ts
const Z0_BANNED = [
  ['THE', 'RMAL'].join(''),
  ['Cha', 'leur'].join(''),
  ['S_', 'heat'].join(''),
  ['cycle', '+1'].join(''),
  ['corri', 'dor'].join(''),
  ['loop', 'Climate'].join(''),
  ['loop_', 'climate'].join(''),
];

const L2_L3_FORBIDDEN = [
  'Math.random(',
  'Date.now(',
  'fetch(',
  'window.',
  'document.',
  "from 'react'",
  "from 'three'",
];

function walkFiles(dir: string, exts: string[]): string[] {
  if (!fs.existsSync(dir)) return [];
  const results: string[] = [];
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) results.push(...walkFiles(full, exts));
    else if (exts.some((e) => entry.name.endsWith(e))) results.push(full);
  }
  return results;
}

function estimateMaxCyclomatic(code: string): number {
  const fnBlocks = code.split(/\b(?:function\s+\w+|=>\s*\{)/g);
  const branchRe = /\b(?:if|else\s+if|for|while|case|catch)\b|&&|\|\||\?/g;
  let maxCc = 1;
  for (const block of fnBlocks) {
    const cc = 1 + (block.match(branchRe)?.length ?? 0);
    if (cc > maxCc) maxCc = cc;
  }
  return maxCc;
}

function scanSourceRules(files: string[]): string[] {
  const errs: string[] = [];
  for (const file of files) {
    const rel = path.relative(ROOT, file).replace(/\\/g, '/');
    const content = fs.readFileSync(file, 'utf8');
    const lines = content.split('\n').length;

    for (const token of Z0_BANNED) {
      if (content.includes(token)) errs.push(`EXOW-E017 [Z0]: "${token}" détecté dans ${rel}`);
    }

    const isTs = file.endsWith('.ts') || file.endsWith('.tsx');
    if (!isTs) continue;

    const isUi = rel.includes('/l7-ui/') || rel.includes('/l6-scenes-3d/');
    const maxLines = isUi ? 300 : 200;
    if (lines > maxLines) errs.push(`EXOW-E020 [R14]: ${rel} = ${lines}L (max ${maxLines}L)`);

    const cc = estimateMaxCyclomatic(content);
    if (cc > 12) errs.push(`EXOW-E020 [CC]: ${rel} CC estimée ${cc} (max 12)`);

    if (rel.includes('/l2-sim-math/') || rel.includes('/l3-engine/')) {
      for (const bad of L2_L3_FORBIDDEN) {
        if (content.includes(bad)) errs.push(`EXOW-E018 [L2/L3]: "${bad}" interdit dans ${rel}`);
      }
    }
  }
  return errs;
}

function checkTriFormatParity(expectedSemver: string): string[] {
  const errs: string[] = [];
  const baseTag = expectedSemver.split('+')[0];
  const files = [
    'MASTER_BLUEPRINT_FMT-U_v4.0.0-rc.1.md',
    'MASTER_BLUEPRINT_FMT-M_v4.0.0-rc.1.md',
    'MASTER_BLUEPRINT_FMT-S_AISTUDIO_v4.0.0-rc.1.md',
  ];
  for (const f of files) {
    const full = path.join(BP_DIR, f);
    if (!fs.existsSync(full)) {
      errs.push(`EXOW-E019 [DIR-01]: format jumeau manquant (${f})`);
      continue;
    }
    const md = fs.readFileSync(full, 'utf8');
    if (!md.includes(baseTag)) errs.push(`EXOW-E019 [DIR-01]: drift SemVer dans ${f} (attendu ${baseTag})`);
    if (!md.includes('DIR-01')) errs.push(`EXOW-E019 [DIR-01]: directives EXOW.DIR absentes de ${f}`);
  }
  return errs;
}

function main(): void {
  const m0Path = path.join(BP_DIR, 'M0_MetaSemVer.json');
  const m13Path = path.join(BP_DIR, 'M13_SADT_Mapping.json');
  if (!fs.existsSync(m0Path) || !fs.existsSync(m13Path)) {
    console.error('[EXO:AUDIT] NO-GO — M0_MetaSemVer.json ou M13_SADT_Mapping.json introuvable.');
    process.exit(1);
  }

  const m0 = JSON.parse(fs.readFileSync(m0Path, 'utf8')) as M0Manifest;
  const m13 = JSON.parse(fs.readFileSync(m13Path, 'utf8')) as M13Manifest;
  const engineReport = runMatrixEngineAudit(m0, m13);

  const srcFiles = walkFiles(path.join(ROOT, 'src'), ['.ts', '.tsx', '.md', '.json']);
  const ruleErrors = scanSourceRules(srcFiles);
  const triErrors = checkTriFormatParity(m13.semver);
  const allErrors = [...engineReport.errors, ...engineReport.driftNodes, ...ruleErrors, ...triErrors];

  console.log('=== EXO WORLD : 2050 — CLI AUDIT (V0-BOOT) ===');
  console.log(`Matrices M0–M15 : ${engineReport.matricesCovered}/16 | Sous-boîtes D2 : ${engineReport.d2BoxCount}/15`);
  console.log(`DSM Cycles (↺)  : ${engineReport.dsmCycles.length} | Drift SemVer : ${engineReport.driftNodes.length}`);
  console.log(`Fichiers scannés: ${srcFiles.length} | Erreurs totales : ${allErrors.length}`);

  if (allErrors.length > 0) {
    for (const err of allErrors) console.error(`  ✖ ${err}`);
    console.error('RELEASE GATE : NO-GO');
    process.exit(1);
  }

  console.log('RELEASE GATE : GO ✓');
  process.exit(0);
}

main();

