function buildWorkspacePackageJson(ws) {
  const dependencies = {};
  for (const dep of ws.deps) {
    dependencies[dep] = 'workspace:*';
  }
  Object.assign(dependencies, ws.extDeps);

  const scripts = {
    typecheck: 'tsc --noEmit',
    clean: 'rm -rf dist *.tsbuildinfo',
  };

  if (ws.name === '@exo/web-client' || ws.name === '@exo/world-editor') {
    scripts.dev = 'vite';
    scripts.build = 'tsc --noEmit && vite build';
  } else if (ws.name === '@exo/headless-sim') {
    scripts.start = 'tsx src/cli.ts';
    scripts.build = 'tsc --noEmit';
  } else if (ws.name === '@exo/tools') {
    scripts.build = 'tsc --noEmit';
  } else {
    scripts.build = 'tsc --noEmit';
  }

  const pkg = {
    name: ws.name,
    version: '0.1.0',
    private: true,
    type: 'module',
    description: ws.description,
    'x-exo-stratum': ws.stratum,
    ...(ws.isApp
      ? {}
      : {
          main: './src/index.ts',
          types: './src/index.ts',
          exports: { '.': './src/index.ts' },
        }),
    scripts,
    ...(Object.keys(dependencies).length > 0 ? { dependencies } : {}),
    ...(Object.keys(ws.devDeps).length > 0 ? { devDependencies: ws.devDeps } : {}),
  };

  return JSON.stringify(pkg, null, 2) + '\n';
}

function buildWorkspaceTsconfig(ws) {
  const wsAbsDir = path.join(ROOT_DIR, ws.dir);
  const relToBase = path.relative(wsAbsDir, path.join(ROOT_DIR, 'tsconfig.base.json')).replace(/\\/g, '/');

  const libs = ws.dom ? ['ES2022', 'DOM', 'DOM.Iterable', 'WebWorker'] : ['ES2022'];
  const compilerOptions = {
    lib: libs,
    noEmit: true,
    ...(ws.jsx ? { jsx: 'react-jsx' } : {}),
  };

  const tsconfig = {
    extends: relToBase,
    compilerOptions,
    include: ws.noSrcDir ? ['**/*.ts'] : ['src/**/*.ts', 'src/**/*.tsx'],
    exclude: ['node_modules', 'dist'],
  };

  return JSON.stringify(tsconfig, null, 2) + '\n';
}

function buildSourceContent(ws, relFile, responsibility) {
  const ext = path.extname(relFile);

  // 1. Manifestes JSON de plugins (S5)
  if (relFile.endsWith('plugin.manifest.json')) {
    const manifest = {
      id: ws.name,
      version: '0.1.0',
      stratum: ws.stratum,
      description: ws.description,
      entry: './src/index.ts',
      compatibleEngineRange: '>=0.1.0 <1.0.0',
      hooks: ws.name.includes('orbital')
        ? ['core-tick', 'hud-panels', 'catalog-override']
        : ['crisis-director', 'modal-portal'],
      permissions: ['read:world-state', 'emit:commands'],
    };
    return JSON.stringify(manifest, null, 2) + '\n';
  }

  // 2. Shaders WGSL (S2 · @exo/rhi-render)
  if (ext === '.wgsl') {
    const isVert = relFile.includes('.vert.');
    return [
      `// ============================================================================`,
      `// Package        : ${ws.name} (${ws.stratum})`,
      `// Fichier        : ${relFile}`,
      `// Responsabilité : ${responsibility}`,
      `// ============================================================================`,
      '',
      isVert
        ? [
            'struct VertexOutput {',
            '  @builtin(position) position: vec4<f32>,',
            '  @location(0) uv: vec2<f32>,',
            '};',
            '',
            '@vertex',
            'fn main(@location(0) pos: vec3<f32>, @location(1) uv: vec2<f32>) -> VertexOutput {',
            '  var out: VertexOutput;',
            '  out.position = vec4<f32>(pos, 1.0);',
            '  out.uv = uv;',
            '  return out;',
            '}',
          ].join('\n')
        : [
            '@fragment',
            'fn main(@location(0) uv: vec2<f32>) -> @location(0) vec4<f32> {',
            '  return vec4<f32>(uv.x, uv.y, 0.5, 1.0);',
            '}',
          ].join('\n'),
      '',
    ].join('\n');
  }

  // 3. Audit DAG réel pour tools/architecture/verifyDependencyDag.ts
  if (relFile === 'architecture/verifyDependencyDag.ts') {
    return [
      '/**',
      ` * @package ${ws.name}`,
      ` * @stratum ${ws.stratum}`,
      ` * @responsibility ${responsibility}`,
      ' */',
      "import fs from 'node:fs';",
      "import path from 'node:path';",
      '',
      'const STRATUM_ORDER: Record<string, number> = { S1: 1, S2: 2, S3: 3, S4: 4, S5: 5, S6: 6 };',
      '',
      'function collectPackageJsons(dir: string, acc: string[] = []): string[] {',
      '  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {',
      "    if (entry.name === 'node_modules' || entry.name === 'dist' || entry.name === '.git') continue;",
      '    const full = path.join(dir, entry.name);',
      '    if (entry.isDirectory()) collectPackageJsons(full, acc);',
      "    else if (entry.name === 'package.json') acc.push(full);",
      '  }',
      '  return acc;',
      '}',
      '',
      'export function verifyDependencyDag(rootDir = process.cwd()): void {',
      '  const pkgFiles = collectPackageJsons(rootDir);',
      '  const strata = new Map<string, { stratum: string; deps: string[] }>();',
      '',
      '  for (const file of pkgFiles) {',
      "    const json = JSON.parse(fs.readFileSync(file, 'utf8'));",
      "    if (!json['x-exo-stratum']) continue;",
      "    const deps = Object.entries(json.dependencies ?? {}).filter(([, v]) => String(v).startsWith('workspace:')).map(([k]) => k);",
      "    strata.set(json.name, { stratum: json['x-exo-stratum'], deps });",
      '  }',
      '',
      '  const violations: string[] = [];',
      '  for (const [pkg, info] of strata.entries()) {',
      '    const currentRank = STRATUM_ORDER[info.stratum] ?? 99;',
      '    for (const dep of info.deps) {',
      '      const target = strata.get(dep);',
      '      if (!target) { violations.push(`${pkg} -> dépendance workspace introuvable: ${dep}`); continue; }',
      '      const targetRank = STRATUM_ORDER[target.stratum] ?? 99;',
      '      if (targetRank > currentRank) {',
      '        violations.push(`VIOLATION STRATE: ${pkg} (${info.stratum}) importe ${dep} (${target.stratum})`);',
      '      }',
      "      if (pkg === '@exo/headless-sim' && (dep === '@exo/rhi-render' || dep === '@exo/ui-kit' || dep === '@exo/audio')) {",
      '        violations.push(`VIOLATION HEADLESS: ${pkg} ne doit jamais importer ${dep}`);',
      '      }',
      '    }',
      '  }',
      '',
      '  if (violations.length > 0) {',
      "    console.error('❌ Violations DAG détectées :\\n' + violations.map((v) => '  - ' + v).join('\\n'));",
      '    process.exit(1);',
      '  }',
      '  console.log(`✅ DAG AAA validé : ${strata.size} workspaces conformes (S1 → S6).`);',
      '}',
      '',
      'verifyDependencyDag(path.resolve(process.cwd(), ".."));',
      '',
    ].join('\n');
  }

  // 4. Barrels src/index.ts
  if (relFile === 'src/index.ts') {
    const exportLines = ws.files
      .map(([f]) => f)
      .filter((f) => f !== 'src/index.ts' && (f.endsWith('.ts') || f.endsWith('.tsx')) && !f.endsWith('.worker.ts'))
      .map((f) => {
        const relImport = './' + f.slice('src/'.length).replace(/\.(tsx|ts)$/, '');
        return `export * from '${relImport}';`;
      });

    return [
      '/**',
      ` * @package ${ws.name}`,
      ` * @stratum ${ws.stratum}`,
      ` * @responsibility ${responsibility}`,
      ' */',
      ...exportLines,
      '',
    ].join('\n');
  }

  // 5. Composants React (.tsx)
  if (ext === '.tsx') {
    const compName = toIdentifier(relFile);
    const isEntry = relFile.endsWith('main.tsx');
    if (isEntry) {
      return [
        '/**',
        ` * @package ${ws.name}`,
        ` * @stratum ${ws.stratum}`,
        ` * @responsibility ${responsibility}`,
        ' */',
        "import { StrictMode } from 'react';",
        "import { createRoot } from 'react-dom/client';",
        '',
        'export function mountApplication(containerId = "root"): void {',
        '  const rootEl = document.getElementById(containerId);',
        '  if (!rootEl) return;',
        '  createRoot(rootEl).render(',
        '    <StrictMode>',
        `      <main data-exo-app="${ws.name}">Exo World 2050 — ${ws.name}</main>`,
        '    </StrictMode>',
        '  );',
        '}',
        '',
      ].join('\n');
    }

    return [
      '/**',
      ` * @package ${ws.name}`,
      ` * @stratum ${ws.stratum}`,
      ` * @responsibility ${responsibility}`,
      ' */',
      "import type { ReactElement } from 'react';",
      '',
      `export interface ${compName}Props {`,
      '  readonly className?: string;',
      '}',
      '',
      `export function ${compName}({ className }: ${compName}Props): ReactElement {`,
      `  return <section className={className} data-exo-component="${compName}" />;`,
      '}',
      '',
    ].join('\n');
  }

  // 6. Web Workers (.worker.ts)
  if (relFile.endsWith('.worker.ts')) {
    const workerId = toIdentifier(relFile);
    return [
      '/**',
      ` * @package ${ws.name}`,
      ` * @stratum ${ws.stratum}`,
      ` * @responsibility ${responsibility}`,
      ' */',
      `export interface ${workerId}Request {`,
      '  readonly taskId: string;',
      '  readonly payload: ArrayBuffer;',
      '}',
      '',
      `export interface ${workerId}Response {`,
      '  readonly taskId: string;',
      '  readonly ok: boolean;',
      '}',
      '',
      'self.onmessage = (event: MessageEvent<unknown>): void => {',
      '  const data = event.data as Partial<{ taskId: string }>;',
      '  self.postMessage({ taskId: data?.taskId ?? "unknown", ok: true });',
      '};',
      '',
    ].join('\n');
  }

  // 7. Modules TypeScript standards (.ts)
  const symbol = toIdentifier(relFile);
  const pascal = symbol.charAt(0).toUpperCase() + symbol.slice(1);
  return [
    '/**',
    ` * @package ${ws.name}`,
    ` * @stratum ${ws.stratum}`,
    ` * @file ${relFile}`,
    ` * @responsibility ${responsibility}`,
    ' */',
    '',
    `export const ${pascal}Meta = {`,
    `  package: '${ws.name}',`,
    `  stratum: '${ws.stratum}',`,
    `  module: '${relFile}',`,
    '} as const;',
    '',
    `export interface ${pascal}Contract {`,
    '  readonly id: string;',
    '}',
    '',
  ].join('\n');
}

// ============================================================================
// 3. EXÉCUTION DU SCAFFOLDING & CONTRÔLE D'INTÉGRITÉ
// ============================================================================

function main() {
  fs.mkdirSync(ROOT_DIR, { recursive: true });
  buildRootFiles();

  let totalSourceFiles = 0;
  let writtenFiles = 0;
  const countsByStratum = {};

  for (const ws of WORKSPACES) {
    const wsDir = path.join(ROOT_DIR, ws.dir);
    fs.mkdirSync(wsDir, { recursive: true });

    // 1. package.json + tsconfig.json du workspace
    writeFileSafe(path.join(wsDir, 'package.json'), buildWorkspacePackageJson(ws));
    writeFileSafe(path.join(wsDir, 'tsconfig.json'), buildWorkspaceTsconfig(ws));

    // 2. Fichiers sources du workspace
    for (const [relFile, responsibility] of ws.files) {
      totalSourceFiles += 1;
      countsByStratum[ws.stratum] = (countsByStratum[ws.stratum] ?? 0) + 1;
      const absFile = path.join(wsDir, relFile);
      const content = buildSourceContent(ws, relFile, responsibility);
      if (writeFileSafe(absFile, content)) {
        writtenFiles += 1;
      }
    }
  }

  // Contrôle strict des compteurs AAA
  if (WORKSPACES.length !== 20 || totalSourceFiles !== 262) {
    throw new Error(
      `Écart détecté : ${WORKSPACES.length} workspaces (attendu 20), ${totalSourceFiles} fichiers sources (attendu 262).`
    );
  }

  console.log(`\n🚀 Monorepo AAA Exo World 2050 initialisé dans : ${ROOT_DIR}\n`);
  console.log('Répartition vérifiée par strate :');
  for (const [stratum, count] of Object.entries(countsByStratum)) {
    console.log(`  • ${stratum} : ${count} fichiers sources`);
  }
  console.log(`\nTotal : ${WORKSPACES.length} workspaces · ${totalSourceFiles} fichiers sources (${writtenFiles} créés/mis à jour).`);
  console.log('\nCommandes suivantes :');
  console.log(`  cd ${path.relative(process.cwd(), ROOT_DIR) || '.'}`);
  console.log('  pnpm install');
  console.log('  pnpm arch:verify');
  console.log('  pnpm typecheck\n');
}

main();